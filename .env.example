# === LLM ===
# Generation runs through the local `claude` CLI (Claude.ai subscription usage).
# Run `claude login` once on this machine — no API key needed.
WRITER_MODEL=claude-opus-4-6
CLASSIFIER_MODEL=claude-haiku-4-5-20251001

# === Tutorial Hunter Integration ===
HUNTER_API_URL=http://localhost:8000
HUNTER_DB_PATH=../ai-tutorial-hunter/tutorial_hunter.db

# === ai-evolution.com.au Deployment ===
PULSE_API_URL=https://ai-evolution.com.au/api
PULSE_API_KEY=
PULSE_AUTHOR_NAME=The Pulse AI
PULSE_CATEGORY=AI Guides

# === Output ===
OUTPUT_DIR=./output
PREVIEW_PORT=3000

# === App ===
LOG_LEVEL=INFO
MAX_TUTORIAL_WORDS=5000
MIN_TUTORIAL_WORDS=2000
